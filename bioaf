# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# Allow this script to be sourced by tests without triggering the dispatch.
# When sourced, BASH_SOURCE[0] differs from $0; only run dispatch on direct exec.
if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
    return 0
fi

command="${1:-help}"
shift || true

case "$command" in
    setup)        cmd_setup "$@" ;;
    create-admin) cmd_create_admin ;;
    start)        cmd_start ;;
    # Host step the target's install.sh runs during any release's update (plan 22); not in help.
    ensure-cloud-logging) ensure_cloud_logging ;;
    # Host step setup, start and the target's install.sh run during any release's update (plan 23).
    ensure-update-agent) ensure_update_agent ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    status)   cmd_status ;;
    logs)     cmd_logs "$@" ;;
    build)    cmd_build "$@" ;;
    migrate)  cmd_migrate ;;
    migrate-down) cmd_migrate_down "$@" ;;
    seed)     cmd_seed "$@" ;;
    backup)   cmd_backup ;;
    shell)    cmd_shell "$@" ;;
    dbshell)  cmd_dbshell ;;
    update)   cmd_update "$@" ;;
    reset-db) cmd_reset_db ;;
    register-outputs) cmd_register_outputs "$@" ;;
    rotate-encryption-keys) cmd_rotate_encryption_keys "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        red "Unknown command: $command"
        echo ""
        cmd_help
        exit 1
        ;;
esac
