    echo "  ./bioaf update              # Update to the latest version"
    echo "  ./bioaf update 0.7.0        # Update to a specific version"
    echo ""
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

# Allow this script to be sourced by tests without triggering the dispatch.
# When sourced, BASH_SOURCE[0] differs from $0; only run dispatch on direct exec.
if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
    return 0
fi

command="${1:-help}"
shift || true

case "$command" in
    setup)        cmd_setup "$@" ;;
    create-admin) cmd_create_admin ;;
    start)        cmd_start ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    status)   cmd_status ;;
    logs)     cmd_logs "$@" ;;
    build)    cmd_build "$@" ;;
    migrate)  cmd_migrate ;;
    migrate-down) cmd_migrate_down "$@" ;;
    seed)     cmd_seed "$@" ;;
    backup)   cmd_backup ;;
    shell)    cmd_shell "$@" ;;
    dbshell)  cmd_dbshell ;;
    update)   cmd_update "$@" ;;
    reset-db) cmd_reset_db ;;
    register-outputs) cmd_register_outputs "$@" ;;
    rotate-encryption-keys) cmd_rotate_encryption_keys "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        red "Unknown command: $command"
        echo ""
        cmd_help
        exit 1
        ;;
esac
