cmd_ssh_recovery_diagnostics() {
    # ssh-recovery-diagnostics: publish fixed, read-only facts the backend's recovery preflight needs
    # (plan 03B) to update-status/ssh-recovery-diagnostics.json. No key, configuration file or command
    # output beyond these fields is published. Needs passwordless sudo for sshd's own checks; without
    # it the report says the checks did not pass rather than guessing.
    local provider=unknown instance_id="" token="" eff="" akc=""
    local sshd_ok=false pubkey=false eic=false agent=false oslogin=false
    if instance_id=$(curl -sf --connect-timeout 1 -m 2 -H 'Metadata-Flavor: Google' \
        http://metadata.google.internal/computeMetadata/v1/instance/id 2>/dev/null) && [ -n "$instance_id" ]; then
        provider=gcp
    elif token=$(curl -sf --connect-timeout 1 -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
        http://169.254.169.254/latest/api/token 2>/dev/null) \
        && instance_id=$(curl -sf --connect-timeout 1 -m 2 -H "X-aws-ec2-metadata-token: $token" \
        http://169.254.169.254/latest/meta-data/instance-id 2>/dev/null) && [ -n "$instance_id" ]; then
        provider=aws
    else
        instance_id=unknown
    fi
    sudo -n /usr/sbin/sshd -t >/dev/null 2>&1 && sshd_ok=true
    eff="$(sudo -n /usr/sbin/sshd -T 2>/dev/null || true)"
    grep -qx 'pubkeyauthentication yes' <<< "$eff" && pubkey=true
    akc="$(awk '$1 == "authorizedkeyscommand" { $1 = ""; sub(/^ /, ""); print; exit }' <<< "$eff")"
    [ "$akc" = none ] && akc=""
    dpkg -s ec2-instance-connect >/dev/null 2>&1 && eic=true
    [ "$(systemctl is-active google-guest-agent 2>/dev/null)" = active ] && agent=true
    grep -q oslogin /etc/nsswitch.conf 2>/dev/null && oslogin=true
    python3 -I -c "$HOST_IO_PY" write-diagnostics "$SCRIPT_DIR" \
        instance_id "$instance_id" provider "$provider" sshd_ok "$sshd_ok" pubkey_auth "$pubkey" \
        guest_agent "$agent" oslogin "$oslogin" eic_package "$eic" authorized_keys_command "${akc:0:200}"
}

cmd_import_git_known_hosts() {
    # import-git-known-hosts <file> <source>: approve custom Git server keys (plan 03C). The file holds
    # known_hosts lines obtained and checked independently of the connection (never ssh-keyscan output);
    # <source> records where they came from. Replaces the previously approved set.
    local file="${1:-}" source="${2:-}"
    if [ -z "$file" ] || [ -z "$source" ] || [ ! -r "$file" ] || [ ! -f "$file" ]; then
        red "Usage: ./bioaf import-git-known-hosts <known_hosts file> \"<where the keys came from>\""
        return 2
    fi
    bold "=== Approve custom Git server keys ==="
    $DC exec -T backend python -m app.cli.import_git_known_hosts /dev/stdin --source "$source" < "$file"
}

public_ipv4_from_metadata() {
    # This VM's public IPv4 address from its cloud metadata (GCP, then AWS IMDSv2); empty if none.
    local ip token
    ip=$(curl -sf --connect-timeout 1 -m 2 -H 'Metadata-Flavor: Google' \
        http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip 2>/dev/null) \
        && [ -n "$ip" ] && { printf '%s' "$ip"; return 0; }
    token=$(curl -sf --connect-timeout 1 -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' \
        http://169.254.169.254/latest/api/token 2>/dev/null) || return 0
    curl -sf --connect-timeout 1 -m 2 -H "X-aws-ec2-metadata-token: $token" \
        http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true
}

cmd_tls_issue_ip() {
    # tls-issue-ip [address]: a Let's Encrypt certificate for this server's public IP address (defaults to
    # the address in the VM's metadata). Renewed automatically by the update agent.
    local ip="${1:-$(public_ipv4_from_metadata)}"
    if [ -z "$ip" ]; then
        red "This server has no public IPv4 address. Private installations use a certificate from your"
        red "organization's own certificate authority: Settings > Networking > Upload certificate."
        exit 1
    fi
    bold "Requesting a certificate for $ip..."
    if tls_issue_ip "$ip"; then
        green "HTTPS now uses a trusted certificate for $ip (notebooks on port 8443 too)."
    else
        exit 1
    fi
}

cmd_contain_notebook_exposure() {
    # contain-notebook-exposure [--apply]: report (and with --apply remove) public listeners of notebook
    # sessions launched before the protected gateway (plan 03.5F). Nothing is stopped or deleted.
    $DC exec -T backend python -m app.cli.contain_notebook_exposure "$@"
}

cmd_tls_renew() {
    tls_renew || exit 1
}

cmd_tls_install_uploaded() {
    tls_install_uploaded || exit 1
    green "The uploaded certificate is installed."
}

