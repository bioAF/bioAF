.DS_Store

# Claude Code project settings
.claude/

# Graphify
.graphifyignore
graphify-out/
.graphify-runs/
.graphify-corpus/

# Local-only working documents (specs, scratch, plans)
local/
documentation/

# Impeccable design-review snapshots (local archive/backlog)
.impeccable/

# Environment
.env

# TLS certificates
docker/certs/

# Python
*.pyc
__pycache__/
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# pytest-cov data files (.coverage, and .coverage.<host>.<pid> from parallel runs)
.coverage
.coverage.*

# Node
.next/
node_modules/
frontend/coverage/
*.tsbuildinfo

# Update system
update-status/
update-requests/
# Recovery dumps the update writes on the host (each holds the whole database)
/backups/
# Host-only detail from managed-file reconciliation (candidates, validation output) and the update
# agent's private log; never mounted
/host-only/
# The update agent's private staging for status writes and its running-code record; never mounted
/host-state/

# Terraform
*.tfvars
!terraform.tfvars.template
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
