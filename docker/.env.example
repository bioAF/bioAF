# PostgreSQL
POSTGRES_USER=bioaf
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bioaf

# Backend (BIOAF_ prefix required, see app/config.py)
DATABASE_URL=postgresql+asyncpg://bioaf:CHANGE_ME@db:5432/bioaf
SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING

# Data-at-rest encryption (Fernet / MultiFernet). Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# install.sh fills this in automatically. DO NOT COMMIT a real value here.
# Losing this value makes encrypted DB columns unrecoverable; back it up
# separately from the dump bucket.
BIOAF_ENCRYPTION_KEYS=CHANGE_ME_TO_FERNET_KEY

# Frontend
NEXT_PUBLIC_API_URL=

# Environment (production, development, poc)
BIOAF_ENVIRONMENT=production
