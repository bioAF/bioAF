FROM python:3.12-slim

LABEL org.opencontainers.image.source=https://github.com/bioAF/bioAF

# Install system dependencies (Terraform + weasyprint rendering libs)
# Terraform >= 1.10: the AWS S3 state backend uses native lockfile locking
# (`use_lockfile`), which was added in 1.10. 1.x is backward-compatible, so the
# GCS backend / google provider used on GCP are unaffected.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip postgresql-client \
    libcairo2 libpango-1.0-0 libpangoft2-1.0-0 libgdk-pixbuf-2.0-0 libffi-dev && \
    curl -fsSL https://releases.hashicorp.com/terraform/1.10.5/terraform_1.10.5_linux_amd64.zip -o terraform.zip && \
    unzip terraform.zip -d /usr/local/bin/ && \
    rm terraform.zip && \
    apt-get purge -y curl unzip && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app

# change_7.2 section 7: which build this image IS, baked in at build time.
#
# Studies 32 and 33 both reported version 2026.9.1 and ran on different code: the version tag is
# mutable and the container had been rebuilt between them, so the exports established that observed
# behaviour differed and could not attribute the difference to anything. These are read by the
# application and recorded per execution stage.
#
# Empty is the honest default. The feature records an unstamped build as an explicit UNKNOWN rather
# than guessing, and these must NOT be set in docker-compose's `environment:`, which would override
# the baked value with an empty string at runtime.
ARG BIOAF_BUILD_COMMIT=""
ARG BIOAF_BUILD_IMAGE_DIGEST=""
ENV BIOAF_BUILD_COMMIT=$BIOAF_BUILD_COMMIT
ENV BIOAF_BUILD_IMAGE_DIGEST=$BIOAF_BUILD_IMAGE_DIGEST

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml .
COPY app/ app/
COPY alembic/ alembic/
COPY terraform/ terraform/

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
