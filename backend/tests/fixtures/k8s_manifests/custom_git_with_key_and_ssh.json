      },
      "kind": "Secret",
      "metadata": {
        "labels": {
          "bioaf.io/managed": "true"
        },
        "name": "bioaf-gcs-sa-key"
      },
      "type": "Opaque"
    },
    {
      "apiVersion": "v1",
      "data": {
        "id_rsa": "LS0tLS1CRUdJTiBPUEVOU1NIIFBSSVZBVEUgS0VZLS0tLS0KS0VZCi0tLS0tRU5EIE9QRU5TU0ggUFJJVkFURSBLRVktLS0tLQ=="
      },
      "kind": "Secret",
      "metadata": {
        "labels": {
