{
  "job": {
    "body": {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "labels": {
          "bioaf.io/pipeline": "nf-core-scrnaseq",
          "bioaf.io/pipeline-run": "101",
          "bioaf.io/pool": "pipelines"
        },
        "name": "bioaf-pipeline-101-1790000000",
        "namespace": "bioaf-pipelines"
      },
      "spec": {
        "backoffLimit": 0,
        "template": {
          "metadata": {
            "annotations": {
              "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "/bin/sh",
                  "-c",
                  "cat /data/nextflow.config && nextflow run https://github.com/nf-core/scrnaseq -r 2.7.1 -c /data/nextflow.config --input /data/samplesheet.csv -with-report gs://bioaf-raw-test/nextflow-reports/bioaf-pipeline-101-1790000000/report.html -with-trace gs://bioaf-raw-test/nextflow-traces/bioaf-pipeline-101-1790000000/trace.tsv --aligner=star --genome=GRCh38 --protocol=10XV3 --outdir=gs://bioaf-results-test/experiments/9/pipeline-runs/101"
                ],
                "env": [
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "value": "/secrets/gcp/key.json"
                  }
                ],
                "image": "nextflow/nextflow:25.10.4",
                "name": "pipeline",
                "terminationMessagePolicy": "FallbackToLogsOnError",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  },
                  {
                    "mountPath": "/secrets/gcp",
                    "name": "gcp-sa-key",
                    "readOnly": true
                  }
                ]
              }
            ],
            "initContainers": [
              {
                "command": [
                  "/bin/sh",
                  "-c",
                  "printf '%s' 'sample,fastq_1,fastq_2\nS1,gs://b/S1_R1.fq.gz,gs://b/S1_R2.fq.gz\n' > /data/samplesheet.csv"
                ],
                "env": [
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "value": "/secrets/gcp/key.json"
                  }
                ],
                "image": "alpine:3.19",
                "name": "write-samplesheet",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  },
                  {
                    "mountPath": "/secrets/gcp",
                    "name": "gcp-sa-key",
                    "readOnly": true
                  }
                ]
              },
              {
                "command": [
                  "/bin/sh",
                  "-c",
                  "cat > /data/nextflow.config << 'NFEOF'\nprocess.executor = 'k8s'\nk8s.namespace = 'bioaf-pipelines'\nk8s.serviceAccount = 'bioaf-pipeline-runner'\nprocess.pod = [[label: 'bioaf.io/run-id', value: '101']]\nworkDir = 'gs://bioaf-raw-test/nextflow-work/run-101'\nwave.enabled = true\nfusion.enabled = true\nfusion.exportStorageCredentials = true\nprocess.resourceLimits = [cpus: 14, memory: '110.GB']\nprocess.disk = { \"120.GB\" }\nprocess.maxRetries = 3\nprocess.errorStrategy = { task.exitStatus in [143, 137, 247] ? (task.attempt <= 3 ? 'retry' : 'finish') : (task.attempt <= 2 ? 'retry' : 'finish') }\nk8s.pod = [[annotation: 'cluster-autoscaler.kubernetes.io/safe-to-evict', value: 'false'], [nodeSelector: 'bioaf.io/pool=pipelines'], [toleration: [key: 'bioaf.io/pool', operator: 'Equal', value: 'pipelines', effect: 'NoSchedule']], [secret: 'bioaf-gcs-sa-key', mountPath: '/secrets/gcp'], [env: 'GOOGLE_APPLICATION_CREDENTIALS', value: '/secrets/gcp/key.json']]\ndocker.enabled = true\nprocess { withName: 'MULTIQC' { ext.args = '--export' } }\nprocess { withName: 'STAR_ALIGN' { ext.args = '--readFilesCommand zcat --runDirPerm All_RWX --outWigType bedGraph --twopassMode Basic --outSAMtype BAM SortedByCoordinate --limitBAMsortRAM 59055800320' } }\nNFEOF"
                ],
                "env": [
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "value": "/secrets/gcp/key.json"
                  }
                ],
                "image": "alpine:3.19",
                "name": "write-nf-config",
                "volumeMounts": [
                  {
                    "mountPath": "/data",
                    "name": "data"
                  },
                  {
                    "mountPath": "/secrets/gcp",
                    "name": "gcp-sa-key",
                    "readOnly": true
                  }
                ]
              }
            ],
            "nodeSelector": {
              "bioaf.io/pool": "pipeline-head"
            },
            "restartPolicy": "Never",
            "serviceAccountName": "bioaf-pipeline-runner",
            "tolerations": [
              {
                "effect": "NoSchedule",
                "key": "bioaf.io/pool",
                "value": "pipeline-head"
              }
            ],
            "volumes": [
              {
                "emptyDir": {
                  "sizeLimit": "50Gi"
                },
                "name": "data"
              },
              {
                "name": "gcp-sa-key",
                "secret": {
                  "secretName": "bioaf-gcs-sa-key"
                }
              }
            ]
          }
        },
        "ttlSecondsAfterFinished": 3600
      }
    },
    "namespace": "bioaf-pipelines"
  },
  "result": {
    "job_id": "bioaf-pipeline-101-1790000000",
    "namespace": "bioaf-pipelines",
    "status": "queued"
  },
  "secrets": [
    {
      "apiVersion": "v1",
      "data": {
        "key.json": "eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogImJpb2FmLXRlc3QifQ=="
      },
      "kind": "Secret",
      "metadata": {
        "labels": {
          "bioaf.io/managed": "true"
        },
        "name": "bioaf-gcs-sa-key"
      },
      "type": "Opaque"
    }
  ]
}
