BIOAF_DATABASE_URL=postgresql+asyncpg://bioaf_app:devpassword@localhost:5432/bioaf
BIOAF_JWT_SECRET_KEY=dev-secret-key-do-not-use-in-production
BIOAF_DEBUG=true
BIOAF_ENVIRONMENT=development
BIOAF_USE_SECRET_MANAGER=false
# Required. local simulates compute and storage for development; kubernetes contacts real backends.
BIOAF_COMPUTE_MODE=local
# Centralized log delivery: stdout (default; a host collector such as the Ops Agent ships the JSON
# lines) or direct (the backend ships to Cloud Logging itself; only where nothing collects stdout).
BIOAF_LOG_DELIVERY=stdout
